# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
PORT=4000
NODE_ENV=production

# Map and hospital data (Atlas): only the "emergency-system" database is used
MONGO_URI=

# AI explanation and triage (optional: template fallback works without them)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=8000

# Authority console login (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Hospital panel login (/hospital), dummy shared login for now
HOSPITAL_USERNAME=
HOSPITAL_PASSWORD=

# Optional: minutes-based hospital response window in seconds (default 120)
HOSPITAL_RESPONSE_SECONDS=120
